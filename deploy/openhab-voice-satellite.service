# systemd USER unit (recommended, required when using PipeWire echo cancellation).
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/openhab-voice-satellite.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now openhab-voice-satellite
#   sudo loginctl enable-linger $USER     # keep it running without an open session
#
# For a SYSTEM unit with plain ALSA instead: copy to /etc/systemd/system/,
# add  User=pi  and  SupplementaryGroups=audio  under [Service], and change
# WantedBy to multi-user.target.

[Unit]
Description=openhab-voice-satellite voice assistant (wakeword -> STT -> openHAB -> TTS)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/openhab-voice-satellite
ExecStart=/opt/openhab-voice-satellite/.venv/bin/openhab-voice-satellite --config /opt/openhab-voice-satellite/config.yaml
Environment=HF_HOME=/opt/openhab-voice-satellite/models/hf
# CTranslate2/whisper OpenMP workers sleep between jobs instead of spin-waiting
Environment=OMP_WAIT_POLICY=PASSIVE
# numpy/OpenBLAS handles tiny arrays only; one thread, never spins
Environment=OPENBLAS_NUM_THREADS=1
# Environment=OPENHAB_TOKEN=oh.stt.XXXX   # or keep the token in config.yaml
# Environment=GEMINI_API_KEY=AIzaXXXX     # only when stt/tts engine is "gemini"
# Environment=DEEPGRAM_API_KEY=XXXX       # only when stt/tts engine is "deepgram"
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
