# systemd USER unit. Audio runs natively on PipeWire, so the service must
# live in the same user session as the PipeWire daemon — a system unit is
# not supported.
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/openhab-voice-satellite.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now openhab-voice-satellite
#   sudo loginctl enable-linger $USER     # keep it running without an open session

[Unit]
Description=openhab-voice-satellite voice assistant (wakeword -> STT -> openHAB -> TTS)
After=network-online.target sound.target pipewire.service wireplumber.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/openhab-voice-satellite
ExecStart=/opt/openhab-voice-satellite/.venv/bin/openhab-voice-satellite --config /opt/openhab-voice-satellite/config.yaml
Environment=HF_HOME=/opt/openhab-voice-satellite/models/hf
# CTranslate2/whisper OpenMP workers sleep between jobs instead of spin-waiting
Environment=OMP_WAIT_POLICY=PASSIVE
# numpy/OpenBLAS handles tiny arrays only; one thread, never spins
Environment=OPENBLAS_NUM_THREADS=1
# Environment=OPENHAB_TOKEN=oh.stt.XXXX   # or keep the token in config.yaml,
#   which must then be chmod 600 (see deploy/install.md §4). For a token that
#   never appears in a unit file or a process environment listing either, use
#   EnvironmentFile=%h/.config/openhab-voice-satellite.env (chmod 600).
# Environment=GEMINI_API_KEY=AIzaXXXX     # only when stt/tts engine is "gemini"
# Environment=DEEPGRAM_API_KEY=XXXX       # only when stt/tts engine is "deepgram"
Restart=on-failure
RestartSec=3

# Sandboxing. This process parses network responses (aiohttp), runs large
# native parsers on untrusted audio (onnxruntime, ctranslate2) and optionally
# unpickles verifier files — which config.py itself says to treat as
# executable code. Unconfined, a memory-corruption bug in any of those yields
# the whole user session: ~/.ssh, browser profiles, every user file. None of
# these restrictions costs anything here.
#
# It is a *user* unit, which rules out one whole family of directives: a user
# manager has no CAP_SETPCAP, so anything that shrinks the capability bounding
# set fails the unit outright with status=218 (EXIT_CAPABILITIES) — verified on
# Debian 12 / systemd 252. That is CapabilityBoundingSet= itself and, less
# obviously, ProtectKernelModules= and ProtectClock=, which imply a bounding-set
# drop; all three are left commented below. They cost nothing to lose here: the
# process is unprivileged and NoNewPrivileges=yes keeps it that way, so it could
# not load a module or set the clock regardless.
#
# The rest is version-dependent too. Validate with `systemd-analyze --user
# security openhab-voice-satellite.service` after installing, and loosen only
# what that run shows to be breaking audio.
NoNewPrivileges=yes
# dumps and any other file the service creates stay owner-only
UMask=0077
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# the install tree (config, models) and the HF cache under it must stay writable
ReadWritePaths=/opt/openhab-voice-satellite
ProtectKernelTunables=yes
# implies a bounding-set drop: status=218 in a user unit:
# ProtectKernelModules=yes
ProtectControlGroups=yes
# implies a bounding-set drop: status=218 in a user unit:
# ProtectClock=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# deliberately NOT MemoryDenyWriteExecute=yes: onnxruntime and ctranslate2 map
# executable pages of their own, and denying it breaks model loading outright
# AF_UNIX is the PipeWire/pulse socket; the rest is openHAB + the cloud APIs
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# unsettable without CAP_SETPCAP: status=218 in a user unit:
# CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=default.target
